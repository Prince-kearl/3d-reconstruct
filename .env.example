# Copy to .env.local for local development. In production (e.g. Vercel), set
# these as real environment variables in the project dashboard instead —
# never commit actual values here.
#
# Get these from your Supabase project: Project Settings -> API.
# VITE_SUPABASE_ANON_KEY is the public "anon"/"publishable" key — safe to
# expose client-side. Never use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
